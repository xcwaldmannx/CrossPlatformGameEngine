#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct Entity
{
    vec3 position;
    uint _pad0;
    vec3 rotation;
    uint _pad1;
    vec3 scale;
    uint _pad2;

    vec3 boundsPos;
    uint _pad3;
    vec3 boundsNeg;

    uint isVisible;

    uint meshCount;
    uint meshOffset;
    uint _pad4[2];
};

layout(std430, set = 0, binding = 0x00) buffer Entities
{
    Entity entities[];
};

layout(std430, set = 0, binding = 0x01) buffer VertexBounds
{
    vec4 vertexBounds[];
};

layout(std430, set = 0, binding = 0x02) buffer IndexBounds
{
    uint indexBounds[];
};

layout(push_constant) uniform PushConstants
{
    mat4 cameraVP;
} pushConstants;

mat4 eulerRotationToMat4(vec3 euler)
{
    float cx = cos(euler.x);
    float sx = sin(euler.x);
    float cy = cos(euler.y);
    float sy = sin(euler.y);
    float cz = cos(euler.z);
    float sz = sin(euler.z);

    mat3 Rz = mat3(
        cz, -sz, 0.0,
        sz,  cz, 0.0,
        0.0, 0.0, 1.0
    );

    mat3 Ry = mat3(
         cy, 0.0, sy,
         0.0, 1.0, 0.0,
        -sy, 0.0, cy
    );

    mat3 Rx = mat3(
        1.0, 0.0, 0.0,
        0.0,  cx, -sx,
        0.0,  sx,  cx
    );

    mat3 R = Rz * Ry * Rx;

    mat4 M = mat4(1.0);
    M[0].xyz = R[0];
    M[1].xyz = R[1];
    M[2].xyz = R[2];
    return M;
}

mat4 buildTransform(vec3 pos, vec3 rot, vec3 scale)
{
    mat4 T = mat4(1.0);
    T[3].xyz = pos;

    mat4 R = eulerRotationToMat4(rot);

    mat4 S = mat4(1.0);
    S[0][0] = scale.x;
    S[1][1] = scale.y;
    S[2][2] = scale.z;

    return T * R * S;
}

void generateBoundingBoxVertices(vec3 min, vec3 max, out vec3 v[8])
{
    v[0] = vec3(min.x, min.y, min.z);
    v[1] = vec3(max.x, min.y, min.z);
    v[2] = vec3(max.x, max.y, min.z);
    v[3] = vec3(min.x, max.y, min.z);

    v[4] = vec3(min.x, min.y, max.z);
    v[5] = vec3(max.x, min.y, max.z);
    v[6] = vec3(max.x, max.y, max.z);
    v[7] = vec3(min.x, max.y, max.z);
}

void generateBoundingBoxIndices(uint baseVertex, out uint indices[24])
{
    // Bottom face
    indices[0]  = baseVertex + 0; indices[1]  = baseVertex + 1;
    indices[2]  = baseVertex + 1; indices[3]  = baseVertex + 2;
    indices[4]  = baseVertex + 2; indices[5]  = baseVertex + 3;
    indices[6]  = baseVertex + 3; indices[7]  = baseVertex + 0;

    // Top face
    indices[8]  = baseVertex + 4; indices[9]  = baseVertex + 5;
    indices[10] = baseVertex + 5; indices[11] = baseVertex + 6;
    indices[12] = baseVertex + 6; indices[13] = baseVertex + 7;
    indices[14] = baseVertex + 7; indices[15] = baseVertex + 4;

    // Vertical edges
    indices[16] = baseVertex + 0; indices[17] = baseVertex + 4;
    indices[18] = baseVertex + 1; indices[19] = baseVertex + 5;
    indices[20] = baseVertex + 2; indices[21] = baseVertex + 6;
    indices[22] = baseVertex + 3; indices[23] = baseVertex + 7;
}

void main()
{
    uint entityIdx = gl_GlobalInvocationID.x;
    if (entityIdx >= entities.length())
        return;

    entities[entityIdx].isVisible = 0;

    vec3 boundsVertices[8];
    generateBoundingBoxVertices(entities[entityIdx].boundsNeg, entities[entityIdx].boundsPos, boundsVertices);
    uint vertexBase = entityIdx * 8;

    uint boundsIndices[24];
    generateBoundingBoxIndices(vertexBase, boundsIndices);
    uint indexBase = entityIdx * 24;

    const mat4 entityTransform = buildTransform(entities[entityIdx].position, entities[entityIdx].rotation, entities[entityIdx].scale);

    vec2 minXY = vec2( 1e20);
    vec2 maxXY = vec2(-1e20);

    bool insideFrustum = false;

    vec4 worldBounds[8];

    for (uint i = 0; i < 8; i++)
    {
        worldBounds[i] = entityTransform * vec4(boundsVertices[i], 1.0);
        vec4 clip = pushConstants.cameraVP * worldBounds[i];

        if (clip.w <= 0.0)
            continue;

        vec3 ndc = clip.xyz / clip.w;

        if ((clip.x >= -clip.w && clip.x <= clip.w) &&
            (clip.y >= -clip.w && clip.y <= clip.w) &&
            (clip.z >= 0.0 && clip.z <= clip.w))
        {
            insideFrustum = true;
        }

        minXY = min(minXY, ndc.xy);
        maxXY = max(maxXY, ndc.xy);
    }

    if (!insideFrustum)
        return;

    vec2 ndcSize = maxXY - minXY;
    if (max(ndcSize.x, ndcSize.y) < 0.005)
        return;

    entities[entityIdx].isVisible = 1;

    // write vertices
    for (uint i = 0; i < 8; i++)
    {
        vertexBounds[vertexBase + i] = worldBounds[i];
    }

    // write indices
    for (uint i = 0; i < 24; i++)
    {
        indexBounds[indexBase + i] = boundsIndices[i];
    }
}