#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct Entity
{
	vec3 mPosition;
	uint _pad0;

	vec3 mRotation;
	uint _pad1;

	vec3 mScale;
	uint mMeshCount;

	uint mMeshOffset;
	uint mInstanceLocalOffset;
	uint _pad2[2];
};

struct Mesh
{
	vec3 mPosition;
	uint _pad0;

	vec3 mRotation;
	uint _pad1;

	vec3 mScale;
	uint mTransformOffset;

	uint mTextureIndex;
	uint mInstanceBaseOffset;
	uint _pad2[2];

	vec3 mBoundsPos;
	uint _pad3;

	vec3 mBoundsNeg;
	uint _pad4;
};

struct Instance
{
	mat4 mTransform;
	uint mTextureIndex;
	bool mIsVisible;
	uint _pad[2];
};

struct DrawCommand
{
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

layout(std140, set = 0, binding = 0x00) uniform Camera
{
    mat4 view;
    mat4 proj;
} camera;

layout(std430, set = 0, binding = 0x01) readonly buffer Entities
{
    Entity entities[];
};

layout(std430, set = 0, binding = 0x02) readonly buffer Meshes
{
    Mesh meshes[];
};

layout(std430, set = 0, binding = 0x03) readonly buffer Transforms
{
    mat4 transforms[];
};

layout(std430, set = 0, binding = 0x04) buffer Instances
{
    Instance instances[];
};

mat4 eulerToMat4(vec3 euler)
{
    float cx = cos(euler.x);
    float sx = sin(euler.x);
    float cy = cos(euler.y);
    float sy = sin(euler.y);
    float cz = cos(euler.z);
    float sz = sin(euler.z);

    mat3 Rz = mat3(
        cz, -sz, 0.0,
        sz,  cz, 0.0,
        0.0, 0.0, 1.0
    );

    mat3 Ry = mat3(
         cy, 0.0, sy,
         0.0, 1.0, 0.0,
        -sy, 0.0, cy
    );

    mat3 Rx = mat3(
        1.0, 0.0, 0.0,
        0.0,  cx, -sx,
        0.0,  sx,  cx
    );

    mat3 R = Rz * Ry * Rx;

    mat4 M = mat4(1.0);
    M[0].xyz = R[0];
    M[1].xyz = R[1];
    M[2].xyz = R[2];
    return M;
}

mat4 buildTRS(vec3 pos, vec3 rotEuler, vec3 scale)
{
    mat4 R = eulerToMat4(rotEuler);

    R[0] *= scale.x;
    R[1] *= scale.y;
    R[2] *= scale.z;

    R[3].xyz = pos;

    return R;
}

vec4 getRow(mat4 m, int r)
{
    return vec4(m[0][r], m[1][r], m[2][r], m[3][r]);
}

vec4 normalizePlane(vec4 p)
{
    float invLen = inversesqrt(max(dot(p.xyz, p.xyz), 1e-20));
    return p * invLen;
}

bool boundsCheck(mat4 model, vec3 boundsPos, vec3 boundsNeg, float marginWorld)
{
    vec3 localCenter  = 0.5 * (boundsPos + boundsNeg);
    vec3 localExtents = 0.5 * (boundsPos - boundsNeg);

    vec3 worldCenter = (model * vec4(localCenter, 1.0)).xyz;

    mat3 M = mat3(model);
    mat3 absM = mat3(abs(M[0]), abs(M[1]), abs(M[2]));
    vec3 worldExtents = absM * localExtents;

    // Expand the box a bit in WORLD units for debug purposes
    worldExtents += vec3(marginWorld);

    mat4 VP = camera.proj * camera.view;

    vec4 r0 = vec4(VP[0][0], VP[1][0], VP[2][0], VP[3][0]);
    vec4 r1 = vec4(VP[0][1], VP[1][1], VP[2][1], VP[3][1]);
    vec4 r2 = vec4(VP[0][2], VP[1][2], VP[2][2], VP[3][2]);
    vec4 r3 = vec4(VP[0][3], VP[1][3], VP[2][3], VP[3][3]);

    vec4 planes[6];
    planes[0] = normalizePlane(r3 + r0);
    planes[1] = normalizePlane(r3 - r0);
    planes[2] = normalizePlane(r3 + r1);
    planes[3] = normalizePlane(r3 - r1);
    planes[4] = normalizePlane(r2);       // Vulkan near (z >= 0)
    planes[5] = normalizePlane(r3 - r2);  // Vulkan far  (z <= w)

    for (int i = 0; i < 6; ++i)
    {
        vec3 n = planes[i].xyz;
        float d = planes[i].w;

        float dist   = dot(n, worldCenter) + d;
        float radius = dot(abs(n), worldExtents);

        if (dist + radius < 0.0)
            return false;
    }

    return true;
}

void main()
{
	const uint entityId = gl_GlobalInvocationID.x;

	// no more work, exit
    if (entityId >= entities.length()) return;
	
	const Entity entity = entities[entityId];
	const mat4 entityTRS = buildTRS(entity.mPosition, entity.mRotation, entity.mScale);
	
	for (uint i = 0; i < entity.mMeshCount; i++)
	{
		const Mesh mesh = meshes[entity.mMeshOffset + i];
		const mat4 meshTRS = buildTRS(mesh.mPosition, mesh.mRotation, mesh.mScale);

        const mat4 finalTransform = entityTRS * transforms[mesh.mTransformOffset] * meshTRS;

		uint instanceIndex = mesh.mInstanceBaseOffset + entity.mInstanceLocalOffset;

		if (!boundsCheck(finalTransform, mesh.mBoundsPos, mesh.mBoundsNeg, 0.0))
		{
		    instances[instanceIndex].mIsVisible = false;
            continue;
        }

		instances[instanceIndex].mTransform = finalTransform;
		instances[instanceIndex].mTextureIndex = mesh.mTextureIndex;
		instances[instanceIndex].mIsVisible = true;
	}
}
